import { useState, useEffect } from "react";
import bg from "./assets/batian.jpeg";

const DEFAULT_API = "http://10.112.27.145:8000";

const DEFAULT_TELEMETRY = {
  error_x: 0,
  error_y: 0,
  kp: 0.0006,
  kd: 0.56,
  servo_output_scale: 0.35,
  detected: false,
  control_enabled: false,
  servo_ready: false,
  servo_error: null,
  kinematics_valid: false,
  kinematics_error: null,
  max_abs_theta: 0,
  fps: 0,
  routine_enabled: false,
  routine_key: "none",
  routine_name: "Nenhuma",
  routine_active_factor: 0,
};

function App() {
  const [api] = useState(DEFAULT_API);

  const [kp, setKp] = useState(0.0006);
  const [kd, setKd] = useState(0.56);
  const [scale, setScale] = useState(0.35);

  const [telemetry, setTelemetry] = useState(DEFAULT_TELEMETRY);
  const [connected, setConnected] = useState(false);
  const [lastMessage, setLastMessage] = useState("");

  useEffect(() => {
    const fetchData = async () => {
      try {
        const res = await fetch(`${api}/telemetry`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const data = await res.json();

        setTelemetry({
          ...DEFAULT_TELEMETRY,
          ...data,
        });

        setConnected(true);
      } catch (err) {
        console.log(err);
        setConnected(false);
      }
    };

    fetchData();

    const interval = setInterval(fetchData, 400);

    return () => clearInterval(interval);
  }, [api]);

  const postJson = async (path, body = null) => {
    try {
      const options = {
        method: "POST",
      };

      if (body !== null) {
        options.headers = {
          "Content-Type": "application/json",
        };

        options.body = JSON.stringify(body);
      }

      const res = await fetch(`${api}${path}`, options);
      const data = await res.json();

      setLastMessage(data.msg || JSON.stringify(data));
      return data;
    } catch (err) {
      console.log(err);
      setLastMessage("Erro de comunicação com o Raspberry.");
      return null;
    }
  };

  const sendPid = async (nextKp = kp, nextKd = kd) => {
    await postJson("/pid", {
      kp: Number(nextKp),
      ki: 0,
      kd: Number(nextKd),
    });
  };

  const sendScale = async (nextScale = scale) => {
    await postJson("/control/scale", {
      scale: Number(nextScale),
    });
  };

  const startBalancar = async () => {
    await postJson("/routine/bambole", {
      routine: "bambole",
    });
  };

  const errorX = Number(telemetry.error_x || 0);
  const errorY = Number(telemetry.error_y || 0);

  // Erro zero = centro visual da plataforma.
  const ballLeft = `${Math.max(0, Math.min(100, 50 - (errorX / 320) * 50))}%`;
  const ballTop = `${Math.max(0, Math.min(100, 50 + (errorY / 240) * 50))}%`;

  const routinePercent = Math.round(
    Number(telemetry.routine_active_factor || 0) * 100
  );

  const systemLabel = telemetry.control_enabled
    ? telemetry.routine_enabled
      ? `Balançando (${routinePercent}%)`
      : "Controle ativo"
    : connected
    ? "Pronto"
    : "Offline";

  return (
    <div className="page">
      <style>{styles}</style>

      <header className="header shell">
        <div className="brand">
          <div className="brand-icon">●</div>

          <div>
            <p className="eyebrow">Equilibrator</p>
            <h1>Equilibrator 2000</h1>
          </div>
        </div>

        <div className={`connection-pill ${connected ? "online" : "offline"}`}>
          <span className="status-dot" />
          {connected ? "Conexão online" : "Conexão offline"}
        </div>
      </header>

      <main className="layout">
        <section className="control-panel shell">
          <div className="section-title">
            <div className="section-badge">⚙</div>

            <div>
              <h2>Controle</h2>
              <strong className="current-mode">{systemLabel}</strong>
            </div>
          </div>

          <div className="command-grid">
            <button
              className="button light-button"
              onClick={() => postJson("/control/home")}
            >
              <span className="button-icon">⌂</span>
              Home
            </button>

            <button
              className="button wood-button"
              onClick={() => postJson("/control/enable")}
            >
              <span className="button-icon">▶</span>
              Ligar
            </button>

            <button
              className="button tan-button"
              onClick={() => postJson("/control/disable")}
            >
              <span className="button-icon">⏻</span>
              Desligar
            </button>

            <button
              className="button redwood-button"
              onClick={() => postJson("/control/stop_pwm")}
            >
              <span className="button-icon">■</span>
              Stop PWM
            </button>

            <button
              className="button restart-button"
              onClick={() => postJson("/system/restart")}
            >
              <span className="button-icon">↻</span>
              Reiniciar backend
            </button>

            <button
              className="button emergency-button"
              onClick={() => postJson("/control/stop_pwm")}
            >
              <span className="button-icon">⚠</span>
              Emergência
            </button>
          </div>

          <div className="divider" />

          <div className="routine-box">
            <div className="small-title">
              <span className="section-badge small">▣</span>
              <h3>Rotina</h3>
            </div>

            <div className="routine-grid">
              <button
                className="button balance-button"
                onClick={startBalancar}
              >
                Balançar
              </button>

              <button
                className="button stop-routine-button"
                onClick={() => postJson("/routine/stop")}
              >
                Parar rotina
              </button>
            </div>
          </div>

          <div className="divider" />

          <div className="messages">
            <div className="small-title">
              <span className="section-badge small">▤</span>
              <h3>Mensagens</h3>
            </div>

            <div className="message-box">
              {lastMessage || "Sistema aguardando comando."}
            </div>
          </div>
        </section>

        <section className="platform-panel shell">
          <div className="section-title platform-title">
            <div className="section-badge">□</div>
            <h2>Plataforma</h2>
          </div>

          <div className="platform-card">
            <div className="platform">
              <div className="platform-grid" />
              <div className="platform-axis-x" />
              <div className="platform-axis-y" />
              <div className="platform-center" />
              <div
                className={`ball ${telemetry.detected ? "" : "lost"}`}
                style={{
                  left: ballLeft,
                  top: ballTop,
                }}
              />
            </div>
          </div>
        </section>

        <aside className="right-panel">
          <section className="status-panel shell">
            <div className="section-title compact">
              <div className="section-badge">◈</div>
              <h2>Status</h2>
            </div>

            <div className="status-list">
              <StatusItem
                label="Conexão"
                active={connected}
                activeText="Online"
                inactiveText="Offline"
              />

              <StatusItem
                label="Bola"
                active={telemetry.detected}
                activeText="Detectada"
                inactiveText="Não detectada"
              />

              <StatusItem
                label="Controle"
                active={telemetry.control_enabled}
                activeText="Ativo"
                inactiveText="Desligado"
                neutral={!telemetry.control_enabled}
              />

              <StatusItem
                label="Rotina"
                active={telemetry.routine_enabled}
                activeText="Balançar"
                inactiveText="Parada"
                neutral={!telemetry.routine_enabled}
              />
            </div>
          </section>

          <section className="adjust-panel shell">
            <div className="section-title compact">
              <div className="section-badge">☰</div>
              <h2>Ajustes</h2>
            </div>

            <Slider
              label="Kp"
              value={kp}
              min={0}
              max={0.003}
              step={0.0001}
              decimals={5}
              onChange={(value) => {
                setKp(value);
                sendPid(value, kd);
              }}
            />

            <Slider
              label="Kd"
              value={kd}
              min={0}
              max={1.5}
              step={0.01}
              decimals={2}
              onChange={(value) => {
                setKd(value);
                sendPid(kp, value);
              }}
            />

            <Slider
              label="Força"
              value={scale}
              min={0}
              max={1}
              step={0.05}
              decimals={2}
              onChange={(value) => {
                setScale(value);
                sendScale(value);
              }}
            />
          </section>

          {(telemetry.servo_error || telemetry.kinematics_error) && (
            <div className="error-box shell">
              {telemetry.servo_error && (
                <p>
                  <strong>Servo:</strong> {telemetry.servo_error}
                </p>
              )}

              {telemetry.kinematics_error && (
                <p>
                  <strong>Cinemática:</strong> {telemetry.kinematics_error}
                </p>
              )}
            </div>
          )}
        </aside>
      </main>
    </div>
  );
}

function Slider({
  label,
  value,
  min,
  max,
  step,
  decimals,
  onChange,
}) {
  return (
    <div className="slider-group">
      <div className="slider-label">
        <span>{label}</span>
        <strong>{Number(value).toFixed(decimals)}</strong>
      </div>

      <input
        type="range"
        min={min}
        max={max}
        step={step}
        value={value}
        onChange={(e) => onChange(Number(e.target.value))}
      />
    </div>
  );
}

function StatusItem({
  label,
  active,
  activeText,
  inactiveText,
  neutral = false,
}) {
  return (
    <div className="status-item">
      <div className="status-text">
        <span>{label}</span>
        <strong>{active ? activeText : inactiveText}</strong>
      </div>

      <div
        className={`small-dot ${
          active ? "good" : neutral ? "neutral-dot" : "bad"
        }`}
      />
    </div>
  );
}

