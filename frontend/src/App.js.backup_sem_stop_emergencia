    }

    .status-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .platform-card {
      min-height: 390px;
    }

    .platform {
      min-height: 350px;
    }
  }

  @media (max-width: 720px) {
    .header {
      height: auto;
      align-items: flex-start;
      flex-direction: column;
    }

    .layout {
      grid-template-columns: 1fr;
    }

    .platform-panel {
      order: 1;
    }

    .control-panel {
      order: 2;
    }

    .right-panel {
      order: 3;
      display: flex;
    }

    .status-list {
      grid-template-columns: 1fr;
    }

    .platform-card {
      min-height: 340px;
    }

    .platform {
      min-height: 300px;
    }
  }

  @media (max-width: 460px) {
    .page {
      padding: 10px;
    }

    .command-grid,
    .routine-grid {
      grid-template-columns: 1fr;
    }

    .button {
      width: 100%;
    }

    .restart-button,
    .emergency-button {
      grid-column: auto;
    }
  }
`;

export default App;
